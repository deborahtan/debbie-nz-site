# Security headers for every page. Edit the CSP here when you add a new marketing vendor,
# then run the Playwright CSP check. Violations are reported to /api/csp-report and shown on /site-health.
# To trial a change without blocking anything, rename the header to Content-Security-Policy-Report-Only.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.googletagmanager.com *.google-analytics.com *.analytics.google.com *.googleadservices.com *.doubleclick.net *.googlesyndication.com *.google.com *.gstatic.com connect.facebook.net s.pinimg.com snap.licdn.com analytics.tiktok.com bat.bing.com *.clarity.ms static.ads-twitter.com sc-static.net www.redditstatic.com static.hotjar.com script.hotjar.com challenges.cloudflare.com static.cloudflareinsights.com; connect-src 'self' *.googletagmanager.com *.google-analytics.com *.analytics.google.com *.googleadservices.com *.doubleclick.net *.googlesyndication.com *.google.com *.gstatic.com *.g.doubleclick.net www.google.co.nz www.google.com.au www.facebook.com connect.facebook.net *.pinterest.com *.linkedin.com *.tiktok.com *.tiktokw.us bat.bing.com *.clarity.ms analytics.twitter.com *.snapchat.com *.reddit.com *.hotjar.com *.hotjar.io wss://*.hotjar.com challenges.cloudflare.com cloudflareinsights.com; img-src 'self' data: blob: https:; frame-src 'self' *.googletagmanager.com *.doubleclick.net www.facebook.com *.pinterest.com challenges.cloudflare.com www.youtube.com www.youtube-nocookie.com vars.hotjar.com *.google.com; style-src 'self' 'unsafe-inline' tagmanager.google.com www.googletagmanager.com fonts.googleapis.com; font-src 'self' data: fonts.gstatic.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp
  Reporting-Endpoints: csp="/api/csp-report"
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
