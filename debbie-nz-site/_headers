# Security headers for every page. Edit the CSP here when you add a new marketing vendor,
# then run the Playwright CSP check. Violations are reported to /api/csp-report and shown on /site-health.
# To trial a change without blocking anything, rename the header to Content-Security-Policy-Report-Only.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googletagmanager.com https://tagmanager.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googleadservices.com https://*.doubleclick.net https://*.googlesyndication.com https://*.google.com https://*.gstatic.com https://connect.facebook.net https://s.pinimg.com https://snap.licdn.com https://analytics.tiktok.com https://bat.bing.com https://*.clarity.ms https://static.ads-twitter.com https://sc-static.net https://www.redditstatic.com https://static.hotjar.com https://script.hotjar.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; connect-src 'self' https://*.googletagmanager.com https://tagmanager.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googleadservices.com https://*.doubleclick.net https://*.googlesyndication.com https://*.google.com https://*.gstatic.com https://*.g.doubleclick.net https://www.google.co.nz https://www.google.com.au https://www.facebook.com https://connect.facebook.net https://*.pinterest.com https://*.linkedin.com https://*.tiktok.com https://*.tiktokw.us https://bat.bing.com https://*.clarity.ms https://analytics.twitter.com https://*.snapchat.com https://*.reddit.com https://*.hotjar.com https://*.hotjar.io wss://*.hotjar.com https://challenges.cloudflare.com https://cloudflareinsights.com; img-src 'self' data: blob: https:; frame-src 'self' https://*.googletagmanager.com https://tagmanager.google.com https://*.doubleclick.net https://www.google.com https://www.facebook.com https://*.pinterest.com https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://vars.hotjar.com; style-src 'self' 'unsafe-inline' https://tagmanager.google.com https://www.googletagmanager.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp
  Reporting-Endpoints: csp="/api/csp-report"
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
